// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

plugin zod {
  provider = '@core/zod'
  compile = false
  modelOnly = true
  generateModels = ["Board", "Column", "Task", "Post", "Tag", "PostTag", "Workflow", "WorkflowTrigger", "WorkflowExecution", "WorkflowExecutionLog"]
}

plugin hooks {
  provider = "@zenstackhq/tanstack-query"
  target = "react"
  output = "./hooks/model"
}

plugin openapi {
  provider = '@zenstackhq/openapi'
  output = './app/api/openapi/openapi.json'
  prefix = '/api/model'
  securitySchemes = {
    basic: { type: 'http', scheme: 'basic' },
  }
}

/// Shape of the `auth()` function
type Auth {
  userId           String  @id
  userRole         String?
  organizationId   String?
  organizationRole String?

  @@auth
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TriggerType {
  MANUAL
  CARD_CREATED
  CARD_MOVED
  CARD_UPDATED
  SCHEDULE
  WEBHOOK
}

enum ExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum LogStatus {
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
}

model User {
  id            String    @id
  name          String    @allow('read', true, true)  // Allow anonymous users to read name field, this is used for blog authors
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations  Invitation[]
  assignedTasks Task[]    @relation("AssignedTasks")
  ownedBoards  Board[]   @relation("BoardOwner")
  userBoards   Board[]   @relation("UserBoards")
  authoredPosts Post[]  @relation("AuthoredPosts")
  createdWorkflows     Workflow[]            @relation("WorkflowCreator")
  triggeredExecutions  WorkflowExecution[]   @relation("ExecutionTriggeredBy")
  composioConnections  ComposioConnection[]  @relation("ComposioConnections")

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  @@unique([email])
  @@map("user")
  @@openapi.ignore()
  
  // deny anonymous users
  @@deny('all', auth() == null)
  
  // allow reading user info if user belongs to the same organization
  @@allow('read', auth().organizationId != null && members?[organizationId == auth().organizationId])
  
  // allow users to read their own data
  @@allow('all', auth().userId == id)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@map("session")
  @@openapi.ignore()
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
  @@openapi.ignore()
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
  @@openapi.ignore()
}

model Organization {
  id          String       @id
  name        String
  slug        String?
  logo        String?
  createdAt   DateTime
  metadata    String?
  members              Member[]
  invitations          Invitation[]
  boards               Board[]
  workflows            Workflow[]
  workflowTriggers     WorkflowTrigger[]
  workflowExecutions   WorkflowExecution[]
  composioConnections  ComposioConnection[]

  @@unique([slug])
  @@map("organization")
  @@openapi.ignore()
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
  @@openapi.ignore()
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
  @@openapi.ignore()
}

model Board {
  id             String   @id @default(cuid())
  name           String
  createdAt      DateTime @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?  @default(auth().organizationId) @allow('update', false)
  owner          User     @relation("BoardOwner", fields: [ownerId], references: [id])
  ownerId        String   @default(auth().userId) @allow('update', false)
  columns              Column[]              @relation("BoardColumns")
  users                User[]                @relation("UserBoards")
  workflowTriggers     WorkflowTrigger[]
  workflowExecutions   WorkflowExecution[]

  @@validate(length(name, 1, 512, 'Name must be between 1 and 512 characters'))

  @@map("board")

  // deny anonymous users
  @@deny('all', auth() == null)

  // deny access to boards that don't belong to the user's active organization
  @@deny('all', auth().organizationId != organizationId)

  // users can create boards for themselves
  @@allow('create', auth().userId == ownerId)

  // full access to: board owner, org owner, and org admins
  @@allow('all', auth().userId == ownerId || auth().organizationRole == 'owner' || auth().organizationRole == 'admin')

  // if the board belongs to an org, it's readable to all members
  @@allow('read', organizationId != null)
}

model Column {
  id        String   @id @default(cuid())
  title     String
  order     Int      
  board     Board    @relation("BoardColumns", fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  tasks     Task[]   @relation("ColumnTasks")

  @@map("column")

  // full access if the parent Board allows full access
  @@allow('create', check(board, 'create'))
  @@allow('read', check(board, 'read'))
  @@allow('update', check(board, 'update'))
  @@allow('delete', check(board, 'delete'))
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Int      
  column      Column   @relation("ColumnTasks", fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id])
  assigneeId  String?
  completedAt DateTime?
  isArchived  Boolean  @default(false)

  @@map("task")

  // full access if the parent Column allows access
  @@allow('create', check(column, 'create'))
  @@allow('read', check(column, 'read'))
  @@allow('update', check(column, 'update'))
  @@allow('delete', check(column, 'delete'))
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  color     String?   // Optional color for the tag
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // Many-to-many relationship with posts
  posts     PostTag[]

  @@validate(length(name, 1, 50, 'Tag name must be between 1 and 50 characters'))
  @@validate(length(slug, 1, 50, 'Tag slug must be between 1 and 50 characters'))

  @@map("tag")

  // Allow anyone to read tags
  @@allow('read', true)
  
  // Only admins can create, update, or delete tags
  @@allow('create,update,delete', auth() != null && auth().userRole == 'admin')
}

model PostTag {
  id     String @id @default(cuid())
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@unique([postId, tagId])
  @@map("post_tag")

  // Allow reading if the post is readable
  @@allow('read', check(post, 'read'))
  
  // Allow managing post tags if you can manage the post
  @@allow('create,update,delete', check(post, 'update'))
}

model Post {
  id          String    @id @default(cuid())
  title       String
  content     String    // Rich text content
  excerpt     String   // Short description/summary
  featuredImage String?
  slug        String    @unique // SEO-friendly URL
  published   Boolean   @default(false) // Draft vs published state
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Author relationship
  author      User      @relation("AuthoredPosts", fields: [authorId], references: [id])
  authorId    String    @default(auth().userId) @allow('update', false)
  
  // Many-to-many relationship with tags
  tags        PostTag[]

  @@validate(length(title, 1, 255, 'Title must be between 1 and 255 characters'))
  @@validate(length(slug, 1, 255, 'Slug must be between 1 and 255 characters'))
  @@validate(length(content, 1, 500000, 'Content must be between 1 and 500000 characters'))
  @@validate(length(excerpt, 1, 1000, 'Excerpt must be between 1 and 1000 characters'))

  @@map("post")

  // Allow anyone (anonymous + authenticated) to read published posts
  @@allow('read', published)
  
  // Allow authors to manage their own posts
  @@allow('all', auth() != null && auth().userId == authorId)
  
  // Admin users with blog permissions can do everything
  @@allow('all', auth() != null && auth().userRole == 'admin')
}

// ============================================================
// Workflow Models
// ============================================================

model Workflow {
  id             String         @id @default(cuid())
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  nodesJson      Json           @default("[]")
  edgesJson      Json           @default("[]")
  organization   Organization   @relation(fields: [organizationId], references: [id])
  organizationId String         @default(auth().organizationId) @allow('update', false)
  createdBy      User           @relation("WorkflowCreator", fields: [createdById], references: [id])
  createdById    String         @default(auth().userId) @allow('update', false)
  triggers       WorkflowTrigger[]
  executions     WorkflowExecution[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@validate(length(name, 1, 255, 'Name must be between 1 and 255 characters'))
  @@map("workflow")

  @@deny('all', auth() == null)
  @@deny('all', auth().organizationId != organizationId)
  @@allow('create', auth().userId == createdById)
  @@allow('all', auth().userId == createdById || auth().organizationRole == 'owner' || auth().organizationRole == 'admin')
  @@allow('read', true)
}

model WorkflowTrigger {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String       @default(auth().organizationId) @allow('update', false)
  workflow       Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId     String
  board          Board?        @relation(fields: [boardId], references: [id])
  boardId        String?
  triggerType    TriggerType
  configJson     Json          @default("{}")
  enabled        Boolean       @default(true)
  executions     WorkflowExecution[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("workflow_trigger")

  @@deny('all', auth() == null)
  @@deny('all', auth().organizationId != organizationId)
  @@allow('create', check(workflow, 'update'))
  @@allow('read', check(workflow, 'read'))
  @@allow('update', check(workflow, 'update'))
  @@allow('delete', check(workflow, 'update'))
}

model WorkflowExecution {
  id                String           @id @default(cuid())
  organization      Organization     @relation(fields: [organizationId], references: [id])
  organizationId    String           @default(auth().organizationId) @allow('update', false)
  workflow          Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId        String
  board             Board?            @relation(fields: [boardId], references: [id])
  boardId           String?
  cardId            String?
  status            ExecutionStatus   @default(PENDING)
  inputJson         Json?
  outputJson        Json?
  error             String?
  triggeredByUser   User?             @relation("ExecutionTriggeredBy", fields: [triggeredByUserId], references: [id])
  triggeredByUserId String?
  trigger           WorkflowTrigger?  @relation(fields: [triggerId], references: [id])
  triggerId         String?
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  logs              WorkflowExecutionLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("workflow_execution")

  @@deny('all', auth() == null)
  @@deny('all', auth().organizationId != organizationId)
  @@allow('read', check(workflow, 'read'))
  @@allow('create', check(workflow, 'read'))
  @@allow('update,delete', check(workflow, 'update'))
}

model WorkflowExecutionLog {
  id           String            @id @default(cuid())
  execution    WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  executionId  String
  nodeId       String
  nodeName     String
  status       LogStatus         @default(RUNNING)
  inputJson    Json?
  outputJson   Json?
  error        String?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?
  createdAt    DateTime          @default(now())

  @@map("workflow_execution_log")

  @@allow('read', check(execution, 'read'))
  @@allow('create,update', check(execution, 'update'))
  @@allow('delete', check(execution, 'delete'))
}

model ComposioConnection {
  id               String           @id @default(cuid())
  organization     Organization     @relation(fields: [organizationId], references: [id])
  organizationId   String           @default(auth().organizationId) @allow('update', false)
  user             User             @relation("ComposioConnections", fields: [userId], references: [id])
  userId           String           @default(auth().userId) @allow('update', false)
  appName          String
  composioEntityId String
  status           ConnectionStatus @default(CONNECTED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, userId, appName])
  @@map("composio_connection")
  @@openapi.ignore()

  @@deny('all', auth() == null)
  @@deny('all', auth().organizationId != organizationId)
  @@allow('all', auth().userId == userId)
  @@allow('read', auth().organizationRole == 'owner' || auth().organizationRole == 'admin')
}
